# Copy to .env and fill in. Never commit .env.

# Hugging Face token, only needed for gated models (e.g. UNI / CONCH) after access is granted.
HF_TOKEN=

# Where raw datasets, the feature cache, and model weights live (git-ignored).
LABELLITE_DATA_DIR=./data/raw
LABELLITE_CACHE_DIR=./data/cache
HF_HOME=./.cache/huggingface
